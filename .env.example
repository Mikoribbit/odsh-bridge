# ODSH Bridge 环境配置样例 —— 复制为 .env 后填写
# 认证信息全部为占位符：任何 token/密钥请不要写进仓库。
# 脚本会在启动时自动加载同目录（或 OC_ENV_FILE 指向）的 .env。

# ---- OpenClaw 网关（DSH 侧使用容器名 DNS 寻址，不要用 IP）----
OC_HOST=openclaw
OC_PORT=18789

# 必填：OpenClaw 的 openclaw.json → gateway.auth.token 的取值
OC_TOKEN=REPLACE_WITH_GATEWAY_TOKEN

# origin：留空则自动构造 http://<OC_HOST>:<OC_PORT>
# 该 origin 必须被网关 gateway.controlUi.allowedOrigins 显式放行
OC_ORIGIN=

# 设备身份 JWK 文件路径（默认：<BRIDGE_PATH>/DSH-Workspace/openclaw-device.json）
# 首次运行自动生成 Ed25519 密钥对并持久化；deviceId 随之恒定
OC_KEYS=

# ---- 桥（共享目录）----
BRIDGE_PATH=/root/ODSH-bridge

# Discord 通知频道 id（oc-send / daemon --notify 使用；占位符）
DISCORD_CHANNEL_ID=

# ---- 可选调优 ----
OC_RETRY_MS=8000                # oc-client 配对等待/重连间隔
OC_CONNECT_TIMEOUT_MS=45000     # 连接（握手+配对）超时
OC_REPLY_TIMEOUT_MS=20000       # 单次请求-响应超时
BRIDGE_INTERVAL_MS=5000         # daemon 扫描间隔
BRIDGE_RUN_TIMEOUT_MS=15000     # run-command 超时
BRIDGE_ALLOW_ABS_PATHS=false    # write-file/read-file 是否允许绝对路径（建议 false）
OC_SEND_SCRIPT=                 # 留空自动指向 src/oc-send.mjs