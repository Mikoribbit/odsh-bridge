# ODSH Bridge environment configuration sample — copy to .env and fill in
# 中文：环境配置样例，复制为 .env 后填写。
# All authentication values are placeholders: never commit any real token or key to this repo.
# At startup the scripts auto-load a .env next to them (or the one pointed to by OC_ENV_FILE).

# ---- OpenClaw gateway (from the DSH side, address it by container DNS name, not IP) ----
OC_HOST=openclaw
OC_PORT=18789

# Required: the value of gateway.auth.token in OpenClaw's openclaw.json
OC_TOKEN=REPLACE_WITH_GATEWAY_TOKEN

# origin: leave empty to auto-build http://<OC_HOST>:<OC_PORT>
# This origin must be explicitly allowed by the gateway's gateway.controlUi.allowedOrigins
OC_ORIGIN=

# Device identity JWK file path (default: <BRIDGE_PATH>/DSH-Workspace/openclaw-device.json)
# On first run an Ed25519 key pair is auto-generated and persisted, so deviceId stays constant
OC_KEYS=

# ---- Bridge (shared directory) ----
BRIDGE_PATH=/root/ODSH-bridge

# Discord notification channel id (used by oc-send / daemon --notify; placeholder)
DISCORD_CHANNEL_ID=

# ---- Optional tuning ----
OC_RETRY_MS=8000                # oc-client pairing wait / reconnect interval
OC_CONNECT_TIMEOUT_MS=45000     # connection (handshake + pairing) timeout
OC_REPLY_TIMEOUT_MS=20000       # single request / response timeout
BRIDGE_INTERVAL_MS=5000         # daemon scan interval
BRIDGE_RUN_TIMEOUT_MS=15000     # run-command timeout
BRIDGE_ALLOW_ABS_PATHS=false    # whether write-file/read-file may use absolute paths (false recommended)
OC_SEND_SCRIPT=                 # if empty, automatically points to src/oc-send.mjs